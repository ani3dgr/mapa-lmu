# Cosas que NO se suben: son de cada ordenador, no del programa.

# Configuracion y estado propios de quien lo usa
mapa_config.json
idioma.txt
ruta_juego.txt

# Las vueltas grabadas de cada uno: son suyas y ocupan
sesiones/

# Las grabaciones crudas de los escaneos: pesan mucho y no hacen falta.
# Lo que sirve ya esta destilado dentro de circuitos/
escaneos/

# Copias del archivo antiguo de circuitos
copias_seguridad/

# Lo que sale de compilar: se genera, no se guarda
build/
dist/

# Volcados de las herramientas de diagnostico: son de la sesion de quien las
# ejecuto, no del programa. Se generan de nuevo cuando hagan falta.
buscar_aviso.txt
diagnostico.txt
monitor_amarilla.txt
prueba_salidas.txt

# Basura de Python
__pycache__/
*.pyc
*.pyo

# Sobras de edicion
*.bak
*.antes
*.orig

# Los reglajes de quien usa el programa. NO SE SUBEN NUNCA: son archivos
# suyos, muchos comprados, y este es un repositorio publico.
copias_reglajes/
historial_reglajes.json

# La calibracion sale de los reglajes que tenga cada uno en SU ordenador,
# asi que no vale para nadie mas.
calibracion.json

# Las fichas que rellene cada uno para los coches nuevos. Las que trae el
# programa van dentro de fichas.py.
fichas_coches.json

# Lo monta el programa solo leyendo los resultados del juego, y es distinto
# en cada ordenador: cada uno ha corrido sus carreras.
catalogo_coches.json

# SI se suben, a proposito:
#   circuitos/   los circuitos medidos, para que la gente los tenga
#   idiomas/     las traducciones
#   coches.json  la tabla de equipo -> marca y modelo
